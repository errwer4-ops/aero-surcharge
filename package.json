{
  "name": "fuel-surcharge-pipeline",
  "version": "0.25.0",
  "description": "항공 유류할증료 데이터 수집·파싱·검증 파이프라인 (MVP) (v23: TW/OZ/YP/KE 상세 진입 로직 복구)",
  "main": "scripts/run_pipeline.js",
  "scripts": {
    "dev": "node scripts/serve_local.js",
    "check:env": "node scripts/check_env.js",
    "test:myrealtrip": "node scripts/verify_myrealtrip_integration.js",
    "test:myrealtrip:browser": "node scripts/verify_myrealtrip_browser.js",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/verify_release.cjs --build",
    "verify:release": "node scripts/verify_release.cjs",
    "check:deployment": "node scripts/check_deployment_readiness.cjs",
    "test:platform": "node scripts/verify_platform.cjs",
    "test:calculator": "node scripts/verify_calculator_platform.cjs",
    "validate:data": "node scripts/validate_data.js",
    "validate:data:changes": "node scripts/validate_data.js --base-ref HEAD",
    "validate:service-data": "node scripts/validate_service_data.cjs --base-ref HEAD",
    "test:seo": "node scripts/sync_static_snapshots.cjs --check",
    "test:static": "node scripts/verify_static_sources.cjs",
    "pipeline": "node scripts/run_pipeline.js",
    "pipeline:mock": "node scripts/run_pipeline.js --mock --dry-run",
    "pipeline:dry": "node scripts/run_pipeline.js --mock --dry-run",
    "pipeline:ke": "node scripts/run_pipeline.js --mock --dry-run --only KE"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  }
}
