# ──────────────────────────────────────────
# 항공 유류할증료 파이프라인 환경변수
# 이 파일을 복사해 .env.local 로 저장 후 값을 채우세요.
# .env.local은 .gitignore에 반드시 포함할 것.
# ──────────────────────────────────────────

# [필수] Anthropic API 키
# 용도: lib/parser/index.js — 공지 텍스트 → JSON 구조화
# 없으면: mock 파서로 자동 fallback (파이프라인 중단 없음)
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# [사용 중단] ExchangeRate-API 환율 키 — 새 키를 설정하지 마세요.
# lib/market/index.js의 원격 환율 수집은 미구성·사용 중단 상태입니다.
# 기존 키가 남아 있어도 해당 제공자에게 요청하지 않습니다.
# 반환되는 mock 값은 테스트용이며 공식 시장값으로 발행하지 않습니다.
EXCHANGERATE_API_KEY=

# [비활성] 기존 시장 데이터 플래그 (호환성 유지)
# "true"여도 외부 환율 호출 없이 disabled 상태와 mock_fallback을 반환합니다.
# 미설정·"false" 또는 --mock은 테스트용 mock을 반환합니다.
# 공식 공시 파이프라인은 시장 mock을 발행하지 않고 기존 forecast 피드를 보존합니다.
USE_LIVE_MARKET_DATA=false

# [미구현] EIA Jet Fuel API 키 (향후 확장용)
# 현재는 mock 고정. 구현 시 lib/market/index.js fetchJetFuelPrice() 채울 것.
# EIA_API_KEY=

# [Optional] MyRealTrip partner API test integration
# Used only by Vercel serverless routes under /api/myrealtrip/*.
# Never expose this key in public HTML or browser-side JavaScript.
MYREALTRIP_API_KEY=
MYREALTRIP_API_BASE_URL=
MYREALTRIP_PRODUCTS_ENDPOINT=
MYREALTRIP_MYLINK_ENDPOINT=
MYREALTRIP_RESERVATIONS_ENDPOINT=
MYREALTRIP_REVENUES_ENDPOINT=

# Required before reservations/revenues routes can be used.
# Send as Authorization: Bearer <token> or X-Admin-Token.
MYREALTRIP_ADMIN_TOKEN=

# Optional. Defaults to POST. Change only if the partner specification requires GET.
MYREALTRIP_MYLINK_METHOD=POST

# Optional override for calculator flight calendar examples.
# Defaults to /v1/products/flight/calendar when omitted.
MYREALTRIP_FLIGHTS_ENDPOINT=/v1/products/flight/calendar
